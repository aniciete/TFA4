#--------------------------------------------------------------------
# InfinityFree Production Configuration (tfa3.freedev.app)
#--------------------------------------------------------------------

# Set to development initially if you want to see detailed error messages during setup,
# then change to production once everything is running.
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'https://tfa3.freedev.app/'
app.indexPage = ''

#--------------------------------------------------------------------
# DATABASE (Uncomment once database credentials are created in VistaPanel)
#--------------------------------------------------------------------

# database.default.hostname = sqlXXX.infinityfree.com
# database.default.database = if0_XXXXXX_tfa3
# database.default.username = if0_XXXXXX
# database.default.password = your_vpanel_password
# database.default.DBDriver = MySQLi
# database.default.DBPrefix =
# database.default.port = 3306

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold = 4
