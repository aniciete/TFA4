node_modules/

# Logs and runtime caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# CodeIgniter 4 standard runtime ignores
writable/cache/*
writable/debugbar/*
writable/logs/*
writable/session/*
writable/uploads/*

